# Copy to .env and fill in values (never commit .env)

# Required: Anthropic (NL -> PQL, summarization, and goal agent brain)
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional: override the default Anthropic model
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Required: KumoRFM (https://kumorfm.ai/api-keys - free tier includes daily query allowance)
KUMO_API_KEY=

# HTTP Basic for the UI (defaults match previous demo login)
# BASIC_AUTH_USER=1028@admin
# BASIC_AUTH_PASSWORD=1028@admin

# Optional: "fast" | "normal" | "best" (default: fast)
# KUMO_RFM_RUN_MODE=fast

# Optional: comma-separated allow-list of hostnames the /api/webhook/send proxy
# may forward to. Unset (the default) disables the endpoint entirely.
# Example: WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,discord.com,api.example.com
# WEBHOOK_ALLOWED_HOSTS=
