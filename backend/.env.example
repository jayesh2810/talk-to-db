# Copy to .env and fill in values (never commit .env)

# Required: Anthropic (NL → PQL and summarization)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Required: KumoRFM (https://kumorfm.ai/api-keys — free tier includes daily query allowance)
KUMO_API_KEY=

# HTTP Basic for the UI (defaults match previous demo login)
# BASIC_AUTH_USER=1028@admin
# BASIC_AUTH_PASSWORD=1028@admin

# Optional: "fast" | "normal" | "best" (default: fast)
# KUMO_RFM_RUN_MODE=fast
